/* Pi WebUI - light theme, IDE-style */
:root {
  --bg: #f7f8fa;
  --panel: #ffffff;
  --border: #e2e5ea;
  --text: #1a1d21;
  --text-dim: #6b7280;
  --accent: #4f6ef7;
  --accent-soft: #eef1fe;
  --user-bubble: #4f6ef7;
  --tool-bg: #f0f2f5;
  --ok: #16a34a;
  --err: #dc2626;
  --mono: "Cascadia Code", Consolas, "Courier New", monospace;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; }
body {
  font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
  background: var(--bg); color: var(--text); font-size: 14px;
}
#app { display: flex; height: 100vh; }

/* ---------- 侧边栏 ---------- */
#sidebar {
  width: 260px; min-width: 260px; background: var(--panel);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column; padding: 16px 12px; gap: 14px;
  overflow: hidden;
}
.sidebar-header h1 { font-size: 18px; font-weight: 600; }
.status { font-size: 12px; margin-top: 4px; display: inline-block; padding: 2px 8px; border-radius: 10px; }
.status.online { background: #dcfce7; color: var(--ok); }
.status.offline { background: #f1f1f1; color: var(--text-dim); }
.btn-new {
  padding: 8px; border: 1px solid var(--border); border-radius: 8px;
  background: var(--accent); color: white; cursor: pointer; font-size: 13px;
}
.btn-new:hover { filter: brightness(1.08); }
.sidebar-section { display: flex; flex-direction: column; gap: 6px; min-height: 0; }
.section-title-row { display: flex; align-items: center; justify-content: space-between; }
.section-title { font-size: 11px; text-transform: uppercase; color: var(--text-dim); letter-spacing: 0.5px; }
.icon-btn {
  border: none; background: transparent; color: var(--text-dim);
  cursor: pointer; padding: 2px 6px; border-radius: 4px; font-size: 14px;
}
.icon-btn:hover { background: var(--tool-bg); color: var(--text); }

/* 历史会话区 */
.sessions-section {
  flex: 1; min-height: 0;
}
.search-input {
  padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--bg); color: var(--text); font-size: 13px; outline: none;
}
.search-input:focus { border-color: var(--accent); }
.session-list {
  flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px;
  padding-right: 2px;
}
.session-list::-webkit-scrollbar { width: 6px; }
.session-list::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
.session-empty { color: var(--text-dim); font-size: 12px; padding: 8px; text-align: center; }
.session-group-title {
  font-size: 10px; color: var(--text-dim); text-transform: uppercase;
  padding: 6px 8px 4px; letter-spacing: 0.5px;
}
.session-item {
  position: relative; padding: 8px 10px; border-radius: 6px;
  cursor: pointer; display: flex; flex-direction: column; gap: 2px;
  transition: background 0.12s;
}
.session-item:hover { background: var(--tool-bg); }
.session-item.active {
  background: var(--accent-soft);
  border-left: 3px solid var(--accent);
  padding-left: 7px;
}
.session-item .s-title {
  font-size: 13px; color: var(--text); white-space: nowrap;
  overflow: hidden; text-overflow: ellipsis;
}
.session-item .s-meta {
  font-size: 11px; color: var(--text-dim); display: flex; gap: 6px;
}
.session-item .s-actions {
  position: absolute; right: 4px; top: 4px; display: none; gap: 2px;
}
.session-item:hover .s-actions, .session-item.active .s-actions { display: flex; }
.session-item .s-actions button {
  border: none; background: transparent; cursor: pointer; padding: 2px 4px;
  border-radius: 3px; font-size: 12px; color: var(--text-dim);
}
.session-item .s-actions button:hover { background: var(--panel); color: var(--text); }
.session-item .s-actions button.del:hover { color: var(--err); }

/* 会话过期记忆字号 */
.session-ephemeral-note { font-size: 11px; color: var(--text-dim); padding: 4px 8px; font-style: italic; }

#model-select {
  padding: 6px 8px; border: 1px solid var(--border); border-radius: 6px;
  background: var(--panel); font-size: 13px; color: var(--text);
}
.cwd { font-family: var(--mono); font-size: 11px; color: var(--text-dim); word-break: break-all; }
.stats .stat-row { display: flex; justify-content: space-between; font-size: 12px; padding: 2px 0; color: var(--text-dim); }
.stats .stat-row span:last-child { font-family: var(--mono); color: var(--text); }
.sidebar-footer { margin-top: auto; font-size: 11px; color: var(--text-dim); text-align: center; }

/* ---------- 聊天区 ---------- */
#chat { flex: 1; display: flex; flex-direction: column; min-width: 0; }
#chat-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 24px; border-bottom: 1px solid var(--border);
  background: var(--panel);
}
.chat-header-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
.chat-title { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-sub { font-size: 11px; color: var(--text-dim); font-family: var(--mono); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chat-header-actions { display: flex; gap: 6px; }
.btn-ghost {
  background: transparent; border: 1px solid var(--border); border-radius: 6px;
  padding: 5px 10px; font-size: 12px; color: var(--text-dim); cursor: pointer;
}
.btn-ghost:hover { background: var(--tool-bg); color: var(--text); }
#messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; }

.msg { max-width: 85%; border-radius: 12px; padding: 12px 16px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
.msg.user { align-self: flex-end; background: var(--user-bubble); color: white; }
.msg.assistant { align-self: flex-start; background: var(--panel); border: 1px solid var(--border); }
.msg.assistant .thinking {
  border-left: 3px solid #c7d2fe; padding: 4px 10px; margin-bottom: 8px;
  color: var(--text-dim); font-size: 13px; background: var(--accent-soft); border-radius: 4px;
}
.msg .meta { font-size: 11px; color: var(--text-dim); margin-top: 6px; }

/* 工具调用卡片 */
.tool-card {
  align-self: flex-start; width: 85%; background: var(--tool-bg);
  border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px;
  font-family: var(--mono); font-size: 12px; margin-top: -6px;
}
.tool-card .tool-head { display: flex; justify-content: space-between; color: var(--text-dim); }
.tool-card .tool-name { font-weight: 600; color: var(--text); }
.tool-card .tool-status.ok { color: var(--ok); }
.tool-card .tool-status.err { color: var(--err); }
.tool-card details { margin-top: 4px; }
.tool-card summary { cursor: pointer; color: var(--text-dim); }
.tool-card pre {
  background: #fff; border: 1px solid var(--border); border-radius: 6px;
  padding: 8px; margin-top: 4px; overflow-x: auto; max-height: 200px; white-space: pre-wrap;
}

#tool-activity { padding: 0 24px 4px; font-size: 12px; color: var(--text-dim); height: 18px; }

/* ---------- 输入区 ---------- */
#composer {
  border-top: 1px solid var(--border); background: var(--panel);
  padding: 12px 24px; display: flex; gap: 10px; align-items: flex-end;
}
#input {
  flex: 1; resize: none; border: 1px solid var(--border); border-radius: 10px;
  padding: 10px 12px; font-size: 14px; font-family: inherit; max-height: 160px;
  background: var(--bg); color: var(--text); outline: none;
}
#input:focus { border-color: var(--accent); }
.btn-primary, .btn-secondary {
  padding: 9px 18px; border-radius: 10px; border: none; cursor: pointer; font-size: 14px;
}
.btn-primary { background: var(--accent); color: white; }
.btn-primary:hover { filter: brightness(1.08); }
.btn-primary:disabled { background: #c5cbe3; cursor: not-allowed; }
.btn-secondary { background: var(--tool-bg); border: 1px solid var(--border); color: var(--text); }
.btn-secondary:hover { background: #e7e9ee; }

/* 空状态 */
.empty-hint { text-align: center; color: var(--text-dim); margin-top: 30vh; }
.empty-hint h2 { font-size: 20px; margin-bottom: 8px; color: var(--text); }
