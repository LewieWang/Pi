<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pi WebUI</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div id="app">
  <!-- 侧边栏 -->
  <aside id="sidebar">
    <div class="sidebar-header">
      <h1>π Pi WebUI</h1>
      <div id="pi-status" class="status offline">未连接</div>
    </div>
    <button id="btn-new-session" class="btn-new">＋ 新会话</button>

    <div class="sidebar-section sessions-section">
      <div class="section-title-row">
        <span class="section-title">历史会话</span>
        <button id="btn-refresh-sessions" class="icon-btn" title="刷新">⟳</button>
      </div>
      <input id="session-search" class="search-input" placeholder="搜索会话..." />
      <div id="session-list" class="session-list">
        <div class="session-empty">暂无历史会话</div>
      </div>
    </div>

    <div class="sidebar-section">
      <div class="section-title">模型</div>
      <select id="model-select"></select>
    </div>
    <div class="sidebar-section">
      <div class="section-title">工作目录</div>
      <div id="cwd" class="cwd">-</div>
    </div>
    <div class="sidebar-section stats">
      <div class="section-title">本次会话</div>
      <div class="stat-row"><span>输入 tokens</span><span id="stat-input">0</span></div>
      <div class="stat-row"><span>输出 tokens</span><span id="stat-output">0</span></div>
      <div class="stat-row"><span>消息数</span><span id="stat-messages">0</span></div>
    </div>
    <div class="sidebar-footer">Pi RPC 桥接 · v0.2 (历史会话)</div>
  </aside>

  <!-- 主聊天区 -->
  <main id="chat">
    <div id="chat-header">
      <div class="chat-header-main">
        <span id="chat-title" class="chat-title">当前会话</span>
        <span id="chat-sub" class="chat-sub"></span>
      </div>
      <div class="chat-header-actions">
        <button id="btn-rename" class="btn-ghost" title="重命名">✎ 重命名</button>
        <button id="btn-compact" class="btn-ghost" title="压缩上下文">⊟ 压缩</button>
        <button id="btn-export" class="btn-ghost" title="导出 HTML">⎘ 导出</button>
      </div>
    </div>
    <div id="messages"></div>
    <div id="tool-activity"></div>
    <div id="composer">
      <textarea id="input" placeholder="给 Pi 发消息… (Enter 发送, Shift+Enter 换行)" rows="1"></textarea>
      <div class="composer-actions">
        <button id="btn-abort" class="btn-secondary" title="中断当前任务">■ 中断</button>
        <button id="btn-send" class="btn-primary">发送</button>
      </div>
    </div>
  </main>
</div>
<script src="app.js"></script>
</body>
</html>
