{
	"name": "harness-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Local Pi extensions that implement SoL-Pi patterns without modifying Pi source.",
	"pi": {
		"extensions": [
			"./action-fusion/index.ts",
			"./observation-pack/index.ts",
			"./evidence-reducer/index.ts",
			"./online-compact/index.ts",
			"./token-tracker/index.ts",
			"./savings-tracker/index.ts",
			"./harness-journal/index.ts",
			"./vision-guard/index.ts",
			"./footer-override/index.ts",
			"./image-paste-fix/index.ts"
		]
	},
	"scripts": {
		"build": "tsc",
		"test": "tsc && node --test --test-timeout=10000 --test-reporter=spec dist/tests/*.test.js",
		"check": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@types/node": "^22.0.0",
		"typebox": "^1.3.0",
		"typescript": "^5.0.0"
	}
}